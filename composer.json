{
    "name": "wpzinc/airwallex-php",
    "description": "Unofficial PHP SDK for the Airwallex API",
    "type": "library",
    "license": "MIT",
    "keywords": ["airwallex", "payments", "billing", "subscriptions", "payouts", "fx", "api", "sdk"],
    "homepage": "https://github.com/wpzinc/airwallex-php",
    "authors": [
        {
            "name": "WP Zinc",
            "homepage": "https://www.wpzinc.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WPZinc\\Airwallex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPZinc\\Airwallex\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "generate": "php codegen/generate.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
